{
  "name": "veruszsupportlib",
  "version": "1.0.0",
  "packageManager": "pnpm@11.18.0",
  "description": "Sapling encryption and key derivation for Verus DREAM Apps",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "build:web": "pnpm build:wasm && pnpm build",
    "build:android": "pnpm --filter @veruszsupportlib/react-native-veruszsupport --fail-if-no-match run ubrn:android",
    "build:ios": "pnpm --filter @veruszsupportlib/react-native-veruszsupport --fail-if-no-match run ubrn:ios",
    "build:all": "pnpm build:web && pnpm build:android",
    "test": "cargo test --locked --manifest-path veruszsupportcore/Cargo.toml && cargo test --locked --manifest-path veruszsupportmobile/Cargo.toml",
    "smoke": "node dist-test.mjs",
    "clean": "rm -rf veruszsupportweb/pkg veruszsupportweb/target veruszsupportcore/target veruszsupportmobile/target",
    "setup:web": "rustup target add wasm32-unknown-unknown && cargo install wasm-pack --locked",
    "setup:android": "rustup target add aarch64-linux-android armv7-linux-androideabi i686-linux-android x86_64-linux-android && cargo install cargo-ndk --locked",
    "setup:ios": "rustup target add aarch64-apple-ios aarch64-apple-ios-sim x86_64-apple-ios",
    "build:wasm": "wasm-pack build veruszsupportweb --target bundler --release --out-dir pkg -- --locked"
  },
  "dependencies": {
    "bn.js": "^5.2.3",
    "buffer": "^6.0.3",
    "verus-typescript-primitives": "git+https://github.com/VerusCoin/verus-typescript-primitives.git#d5e3068021cfa83e3aae489403f4d63aad0c1a6c"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.0.0",
    "blake2b": "git+https://github.com/VerusCoin/blake2b-wasm.git",
    "typescript": "~5.8.3",
    "veruszsupport": "link:veruszsupportweb/pkg/",
    "vite": "^7.0.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}